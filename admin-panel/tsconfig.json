{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "typeRoots": ["../smartfox-server/node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "shared/**/*.ts", "tools/**/*.ts", "../web-api/src/admin/**/*.ts", "../smartfox-server/src/admin/**/*.ts"]
}
